# ===== LLM配置（OpenAI兼容接口，必填） =====
# 任意OpenAI兼容服务：OpenAI / DeepSeek / 通义千问(兼容模式) / 智谱等
LLM_API_KEY=sk-你的Key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ===== ima OpenAPI配置（可选，配置后优先走ima知识库） =====
# 获取方式：ima Windows客户端 → 个人菜单 → Claw配置 → 接口凭证页面
# 安全要求：不得写入源码/仓库/截图/演示画面
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KNOWLEDGE_BASE_NAME=任德耀新建华为PC知识库

# ===== 本地知识库兜底（默认使用本仓库上级目录的P1-P8知识库） =====
LOCAL_KB_ROOT=..

# ===== 应用配置 =====
LOG_LEVEL=INFO
